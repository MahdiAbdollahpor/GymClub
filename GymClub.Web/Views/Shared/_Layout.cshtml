@using Microsoft.AspNetCore.Identity
@using GymClub.Domain.Entities
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — GymClub</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap RTL -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">

    <!-- Tailwind (preflight off) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: { preflight: false },
            theme: {
                extend: {
                    colors: {
                        primary: '#CC0000',
                        'primary-dark': '#990000',
                        'primary-light': '#FF1A1A',
                        pure: '#0A0A0A',
                        rich: '#1A1A1A',
                        offblack: '#2D2D2D',
                        warm: '#F9F9F9',
                        lightgray: '#F0F0F0',
                        midgray: '#8C8C8C',
                        darkgray: '#4D4D4D',
                        bordergray: '#E0E0E0',
                        success: '#16A34A',
                        warning: '#D97706',
                        info: '#0369A1',
                    },
                    fontFamily: {
                        sans: ['Vazirmatn', 'Plus Jakarta Sans', 'sans-serif'],
                        display: ['Vazirmatn', 'Syne', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    boxShadow: {
                        'k-sm': '0 1px 4px rgba(0,0,0,0.12)',
                        k: '0 2px 8px rgba(0,0,0,0.16)',
                        'k-md': '0 4px 20px rgba(0,0,0,0.20)',
                        'k-lg': '0 8px 40px rgba(0,0,0,0.28)',
                        'k-crimson': '0 4px 20px rgba(204,0,0,0.30)',
                    }
                }
            }
        }
    </script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-warm font-sans text-pure">

    <!-- Navigation Bar -->
    <header class="k-navbar">
        <div class="k-container flex items-center justify-between h-full">

            <!-- Logo -->
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 group">
                <span class="w-8 h-8 bg-primary flex items-center justify-center shadow-k-crimson">
                    <span class="text-white font-mono font-bold text-lg">G</span>
                </span>
                <span class="text-white font-display font-bold text-xl tracking-tight">GymClub</span>
            </a>

            <!-- Main nav -->
            <nav class="hidden lg:flex items-center gap-8 h-full">
                @{
                    var navItems = new (string title, string controller, string action)[]
                    {
                                ("خانه", "Home", "Index"),
                                ("معرفی باشگاه", "Home", "About"),
                                ("آموزش", "Articles", "Index"),
                                ("فروشگاه", "Products", "Index"),
                                ("برنامه ورزشی", "Workout", "Index"),
                                ("تماس", "Home", "Contact"),
                    };
                }
                @foreach (var item in navItems)
                {
                    <a asp-controller="@item.controller" asp-action="@item.action"
                       class="k-nav-item">@item.title</a>
                }
            </nav>

            <!-- Actions -->
            <div class="flex items-center gap-2">

                <!-- Cart with badge -->
                <a asp-controller="Cart" asp-action="Index" class="relative k-icon-btn" aria-label="سبد خرید">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"
                              d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    <span id="cartBadge"
                          class="absolute -top-1 -left-1 min-w-[18px] h-[18px] px-1 rounded-full bg-primary text-white text-[10px] font-bold flex items-center justify-center hidden">
                        0
                    </span>
                </a>

                @if (SignInManager.IsSignedIn(User))
                {
                    <a asp-controller="Account" asp-action="Index"
                       class="hidden md:inline-block text-[13px] text-midgray hover:text-white transition-colors font-mono" dir="ltr">
                        @User.Identity!.Name
                    </a>
                    <form method="post" asp-controller="Auth" asp-action="Logout" class="inline">
                        <button type="submit" class="k-btn k-btn-ghost k-btn-sm">خروج</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="Login"
                       class="hidden md:inline-block text-[13px] text-midgray hover:text-white transition-colors">ورود</a>
                    <a asp-controller="Auth" asp-action="Register"
                       class="k-btn k-btn-primary k-btn-sm">ثبت‌نام</a>
                }

                <!-- Mobile hamburger -->
                <button class="lg:hidden k-icon-btn"
                        onclick="document.getElementById('mobileMenu').classList.toggle('hidden')">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile menu -->
        <div id="mobileMenu" class="hidden lg:hidden bg-pure border-t border-offblack">
            <div class="k-container py-3 flex flex-col gap-1">
                <a asp-controller="Home" asp-action="Index" class="k-mobile-link">خانه</a>
                <a asp-controller="Home" asp-action="About" class="k-mobile-link">معرفی باشگاه</a>
                <a asp-controller="Articles" asp-action="Index" class="k-mobile-link">آموزش</a>
                <a asp-controller="Products" asp-action="Index" class="k-mobile-link">فروشگاه</a>
                <a asp-controller="Workout" asp-action="Index" class="k-mobile-link">برنامه ورزشی</a>
                <a asp-controller="Home" asp-action="Contact" class="k-mobile-link">تماس</a>
            </div>
        </div>
    </header>

    <!-- Main content -->
    <main class="min-h-[60vh]">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-pure text-white mt-20">
        <div class="k-container py-16">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
                <div class="md:col-span-1">
                    <div class="flex items-center gap-2 mb-4">
                        <span class="w-7 h-7 bg-primary flex items-center justify-center">
                            <span class="text-white font-mono font-bold">G</span>
                        </span>
                        <span class="font-display font-bold text-lg">GymClub</span>
                    </div>
                    <p class="text-[14px] text-midgray leading-relaxed">
                        باشگاه بدن‌سازی با تجهیزات حرفه‌ای، مربیان مجرب و برنامه‌های اختصاصی.
                    </p>
                </div>

                <div>
                    <h4 class="k-label mb-4 text-white">دسترسی سریع</h4>
                    <ul class="space-y-2 text-[14px] text-midgray">
                        <li><a asp-controller="Home" asp-action="About" class="hover:text-white transition-colors">معرفی باشگاه</a></li>
                        <li><a asp-controller="Articles" asp-action="Index" class="hover:text-white transition-colors">مقالات آموزشی</a></li>
                        <li><a asp-controller="Products" asp-action="Index" class="hover:text-white transition-colors">فروشگاه</a></li>
                        <li><a asp-controller="Workout" asp-action="Index" class="hover:text-white transition-colors">برنامه ورزشی</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="k-label mb-4 text-white">حساب کاربری</h4>
                    <ul class="space-y-2 text-[14px] text-midgray">
                        <li><a asp-controller="Auth" asp-action="Login" class="hover:text-white transition-colors">ورود</a></li>
                        <li><a asp-controller="Auth" asp-action="Register" class="hover:text-white transition-colors">ثبت‌نام</a></li>
                        <li><a asp-controller="Account" asp-action="Index" class="hover:text-white transition-colors">پنل کاربری</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="k-label mb-4 text-white">تماس</h4>
                    <ul class="space-y-2 text-[14px] text-midgray">
                        <li class="font-mono">۰۲۱-۱۲۳۴۵۶۷۸</li>
                        <li>info@gymclub.ir</li>
                        <li>تهران، خیابان ولیعصر</li>
                    </ul>
                </div>
            </div>

            <div class="border-t border-offblack mt-12 pt-6 flex flex-col md:flex-row items-center justify-between gap-3 text-[12px] text-midgray">
                <span>© GymClub 2026 — تمامی حقوق محفوظ است.</span>
                <a href="#" class="hover:text-white transition-colors">سیاست حفظ حریم خصوصی</a>
            </div>
        </div>
    </footer>

    <!-- Confirm Modal (partial from step 4) -->
    <partial name="_ConfirmModal" />

    <!-- Toast Container -->
    <div id="toastContainer" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[200] space-y-2"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Global Cart & Toast scripts -->
    <script>
        // ─── Toast ───
        window.toast = (function () {
            function show(msg, type) {
                const c = document.getElementById('toastContainer');
                if (!c) return;
                const el = document.createElement('div');
                const color = type === 'success' ? '#16A34A'
                            : type === 'error'   ? '#CC0000'
                            : '#0A0A0A';
                el.style.background = color;
                el.style.color = '#fff';
                el.style.padding = '10px 18px';
                el.style.borderRadius = '8px';
                el.style.fontSize = '14px';
                el.style.boxShadow = '0 4px 20px rgba(0,0,0,.2)';
                el.style.opacity = '0';
                el.style.transition = 'opacity .2s';
                el.textContent = msg;
                c.appendChild(el);
                requestAnimationFrame(() => el.style.opacity = '1');
                setTimeout(() => {
                    el.style.opacity = '0';
                    setTimeout(() => el.remove(), 200);
                }, 2500);
            }
            return {
                success: msg => show(msg, 'success'),
                error: msg => show(msg, 'error'),
                info: msg => show(msg, 'info')
            };
        })();

        // ─── Cart Badge ───
        window.CartBadge = {
            set(count) {
                const b = document.getElementById('cartBadge');
                if (!b) return;
                b.textContent = count;
                b.classList.toggle('hidden', !count || count <= 0);
                if (count > 0) {
                    b.classList.remove('bump');
                    void b.offsetWidth;
                    b.classList.add('bump');
                }
            }
        };

        // بارگذاری اولیه تعداد سبد
        document.addEventListener('DOMContentLoaded', async function () {
            try {
                const r = await fetch('/cart/count');
                if (r.ok) {
                    const j = await r.json();
                    if (j && typeof j.count === 'number') window.CartBadge.set(j.count);
                }
            } catch { /* silent */ }
        });

        // ─── Global addToCart ───
        window.addToCart = async function (productId, quantity = 1, btn = null) {
            const orig = btn ? btn.innerHTML : null;
            if (btn) { btn.disabled = true; btn.innerHTML = 'در حال افزودن...'; }

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                const r = await fetch('/cart/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest',
                        ...(token ? { 'RequestVerificationToken': token } : {})
                    },
                    body: new URLSearchParams({ productId, quantity })
                });
                const j = await r.json();

                if (j.success) {
                    window.CartBadge.set(j.cartCount);
                    window.toast.success('به سبد خرید اضافه شد');
                    if (btn) {
                        btn.innerHTML = '✓ اضافه شد';
                        setTimeout(() => {
                            if (btn) { btn.disabled = false; btn.innerHTML = orig; }
                        }, 1200);
                    }
                } else {
                    // اگر کاربر لاگین نیست
                    if (j.message && j.message.includes('وارد')) {
                        window.location.href = '/auth/login?returnUrl=' +
                            encodeURIComponent(location.pathname);
                        return;
                    }
                    window.toast.error(j.message || 'خطا در افزودن به سبد');
                    if (btn) { btn.disabled = false; btn.innerHTML = orig; }
                }
            } catch {
                window.toast.error('خطای شبکه');
                if (btn) { btn.disabled = false; btn.innerHTML = orig; }
            }
        };

        // ─── Event delegation: any [data-add-to-cart] ───
        document.addEventListener('click', function (e) {
            const el = e.target.closest('[data-add-to-cart]');
            if (!el) return;
            e.preventDefault();
            e.stopPropagation();

            const pid = el.getAttribute('data-add-to-cart');
            let qty = parseInt(el.getAttribute('data-qty') || '1', 10);

            const qtySrc = el.getAttribute('data-qty-source');
            if (qtySrc) {
                const src = document.getElementById(qtySrc);
                if (src) qty = parseInt(src.value || '1', 10) || 1;
            }

            window.addToCart(pid, qty, el.tagName === 'BUTTON' ? el : null);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>