@{
    ViewData["Title"] = "خطا";
}

<section class="k-container py-20 max-w-[600px]">
    <div class="k-card text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center" style="background:rgba(204,0,0,.08)">
            <svg class="w-8 h-8" style="color:#CC0000" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z" />
            </svg>
        </div>
        <h2 class="text-[22px] font-bold mb-2">خطایی رخ داد</h2>
        <p class="text-midgray text-[14px] mb-6">
            متأسفانه در پردازش درخواست شما مشکلی پیش آمد. لطفاً دوباره تلاش کنید یا با پشتیبانی تماس بگیرید.
        </p>
        @if (ViewBag.ErrorId != null)
        {
            <div class="text-[12px] text-midgray font-mono mb-4" dir="ltr">Error ID: @ViewBag.ErrorId</div>
        }
        <div class="flex gap-2 justify-center">
            <a asp-controller="Home" asp-action="Index" class="k-btn k-btn-primary k-btn-md">بازگشت به خانه</a>
            <a asp-controller="Home" asp-action="Contact" class="k-btn k-btn-ghost k-btn-md">تماس با ما</a>
        </div>
    </div>
</section>