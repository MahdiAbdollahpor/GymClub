@model GymClub.Application.Users.Commands.ChangePassword.ChangePasswordCommand
@{
    ViewData["Title"] = "تغییر رمز";
}

<section class="k-container py-12">
    <div class="k-section-header">
        <div><div class="k-label mb-2">حساب کاربری</div><h2>تغییر رمز عبور</h2></div>
    </div>

    <div class="flex flex-col lg:flex-row gap-6">
        <partial name="_AccountNav" />

        <div class="flex-1 max-w-[600px]">
            <form asp-action="ChangePassword" method="post" class="k-card">
                <div asp-validation-summary="ModelOnly" class="k-alert mb-4"></div>

                <div class="mb-4">
                    <label asp-for="CurrentPassword" class="k-form-label">رمز فعلی</label>
                    <input asp-for="CurrentPassword" type="password" class="k-input" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="NewPassword" class="k-form-label">رمز جدید</label>
                    <input asp-for="NewPassword" type="password" class="k-input" />
                    <div class="k-helper">حداقل ۶ کاراکتر</div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="flex gap-2">
                    <button type="submit" class="k-btn k-btn-primary k-btn-md">تغییر رمز</button>
                    <a asp-action="Index" class="k-btn k-btn-ghost k-btn-md">بازگشت</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}