@model GymClub.Application.Articles.Dtos.ArticleDetailsDto
@using GymClub.Domain.Enums
@{
    ViewData["Title"] = Model.Title;
}

<article class="k-container py-12 max-w-[820px]">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-[13px] text-midgray mb-6">
        <a asp-controller="Home" asp-action="Index" class="hover:text-primary">خانه</a>
        <span>/</span>
        <a asp-action="Index" class="hover:text-primary">آموزش</a>
        @if (!string.IsNullOrEmpty(Model.CategoryTitle))
        {
            <span>/</span>
            <span>@Model.CategoryTitle</span>
        }
    </nav>

    <div class="flex items-center gap-2 mb-4">
        <span class="k-chip k-chip-crimson">@(Model.Type == ArticleType.Training ? "تمرین" : Model.Type == ArticleType.Nutrition ? "تغذیه" : "معرفی")</span>
        <span class="text-[12px] text-midgray font-mono">@Model.PublishedAt?.ToString("yyyy/MM/dd")</span>
        <span class="text-[12px] text-midgray">@Model.ViewCount بازدید</span>
    </div>

    <h1 class="text-[34px] font-bold leading-tight mb-4">@Model.Title</h1>
    <p class="text-[16px] text-darkgray leading-relaxed mb-8">@Model.Summary</p>

    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        <div class="mb-8 -mx-4 md:mx-0">
            <img src="@Model.CoverImageUrl" alt="@Model.Title" class="w-full rounded-lg" />
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.VideoUrl))
    {
        <div class="mb-8 aspect-video bg-black rounded-lg overflow-hidden">
            <video src="@Model.VideoUrl" controls class="w-full h-full"></video>
        </div>
    }

    <div class="prose prose-lg max-w-none article-content">
        @Html.Raw(Model.ContentHtml)
    </div>

    <div class="mt-12 pt-8 border-t border-bordergray flex items-center justify-between">
        <a asp-action="Index" class="k-btn k-btn-ghost k-btn-md">← بازگشت به مقالات</a>
        <span class="text-[13px] text-midgray">نویسنده: @Model.AuthorName</span>
    </div>
</article>

@section Scripts {
    <style>
        .article-content {
            font-size: 16px;
            line-height: 1.85;
            color: #1A1A1A;
        }

            .article-content h2 {
                font-size: 22px;
                font-weight: 700;
                margin: 32px 0 16px;
            }

            .article-content h3 {
                font-size: 18px;
                font-weight: 600;
                margin: 24px 0 12px;
            }

            .article-content p {
                margin-bottom: 16px;
            }

            .article-content img {
                max-width: 100%;
                height: auto;
                border-radius: 8px;
                margin: 16px 0;
            }

            .article-content ul, .article-content ol {
                padding-right: 24px;
                margin-bottom: 16px;
            }

            .article-content li {
                margin-bottom: 6px;
            }

            .article-content a {
                color: #CC0000;
                text-decoration: underline;
            }

            .article-content blockquote {
                border-right: 4px solid #CC0000;
                padding: 8px 16px;
                background: #F9F9F9;
                margin: 16px 0;
                color: #4D4D4D;
            }
    </style>
}