@{
    ViewData["Title"] = "پرداخت ناموفق";
}

<section class="k-container py-20 max-w-[600px]">
    <div class="k-card text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full flex items-center justify-center"
             style="background: rgba(204,0,0,.08)">
            <svg class="w-8 h-8" style="color:#CC0000" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </div>
        <h2 class="text-[22px] font-bold mb-2">پرداخت انجام نشد</h2>
        <p class="text-midgray text-[14px] mb-6">
            @(TempData["PayError"] ?? "پرداخت لغو شد یا خطایی رخ داد.")
        </p>
        <div class="flex gap-2 justify-center">
            <a asp-controller="Cart" asp-action="Index" class="k-btn k-btn-primary k-btn-md">بازگشت به سبد</a>
            <a asp-controller="Products" asp-action="Index" class="k-btn k-btn-ghost k-btn-md">ادامه خرید</a>
        </div>
    </div>
</section>