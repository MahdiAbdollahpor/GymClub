@{
    ViewData["Title"] = ViewBag.Title ?? "خطا";
}

<section class="k-container py-20 max-w-[680px]">
    <div class="k-card text-center" style="padding: 56px 40px;">
        <!-- عدد کد -->
        <div class="font-mono text-[88px] font-bold text-primary leading-none mb-4">
            @ViewBag.Code
        </div>

        <!-- آیکون -->
        <div class="w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center"
             style="background: rgba(204,0,0,.08)">
            @if (ViewBag.Code == 404)
            {
                <svg class="w-8 h-8" style="color:#CC0000" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"
                          d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            }
            else if (ViewBag.Code == 401 || ViewBag.Code == 403)
            {
                <svg class="w-8 h-8" style="color:#CC0000" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"
                          d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            }
            else
            {
                <svg class="w-8 h-8" style="color:#CC0000" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"
                          d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z" />
                </svg>
            }
        </div>

        <!-- عنوان -->
        <h1 class="text-[24px] font-bold mb-3">@ViewBag.Title</h1>

        <!-- پیام -->
        <p class="text-[14px] text-midgray leading-relaxed mb-8">
            @ViewBag.Message
        </p>

        <!-- دکمه‌ها -->
        <div class="flex flex-wrap gap-2 justify-center">
            <a asp-controller="Home" asp-action="Index" class="k-btn k-btn-primary k-btn-md">
                بازگشت به خانه
            </a>
            <button type="button" onclick="history.back()" class="k-btn k-btn-ghost k-btn-md">
                صفحه قبلی
            </button>
            @if (ViewBag.Code == 401 || ViewBag.Code == 403)
            {
                <a asp-controller="Auth" asp-action="Login" class="k-btn k-btn-primary k-btn-md">
                    ورود
                </a>
            }
        </div>
    </div>

    <!-- لینک‌های سریع -->
    <div class="mt-8 text-center">
        <div class="k-label mb-3">صفحات پرطرفدار</div>
        <div class="flex flex-wrap gap-2 justify-center">
            <a asp-controller="Products" asp-action="Index" class="k-chip k-chip-default hover:bg-lightgray transition-colors">فروشگاه</a>
            <a asp-controller="Articles" asp-action="Index" class="k-chip k-chip-default hover:bg-lightgray transition-colors">مقالات</a>
            <a asp-controller="Workout" asp-action="Index" class="k-chip k-chip-default hover:bg-lightgray transition-colors">برنامه ورزشی</a>
            <a asp-controller="Home" asp-action="Contact" class="k-chip k-chip-default hover:bg-lightgray transition-colors">تماس با ما</a>
        </div>
    </div>
</section>