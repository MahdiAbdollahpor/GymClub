@model GymClub.Application.Auth.Commands.ForgotPassword.ResetPasswordCommand
@{
    ViewData["Title"] = "تعیین رمز جدید";
}

<div class="k-auth-wrapper">
    <div class="k-auth-card">
        <div class="k-label mb-2">بازیابی</div>
        <h2>تعیین رمز جدید</h2>
        <p class="k-subtitle">کد ارسال‌شده و رمز جدید خود را وارد کنید.</p>

        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="k-alert"></div>

            <div class="mb-4">
                <label asp-for="PhoneNumber" class="k-form-label">شماره موبایل</label>
                <input asp-for="PhoneNumber" class="k-input" dir="ltr" value="@ViewBag.Phone" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Code" class="k-form-label">کد تأیید</label>
                <input asp-for="Code" class="k-input text-center font-mono" dir="ltr"
                       style="letter-spacing:12px;font-size:22px;height:56px" maxlength="5" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <div class="mb-6">
                <label asp-for="NewPassword" class="k-form-label">رمز جدید</label>
                <input asp-for="NewPassword" type="password" class="k-input" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="k-btn k-btn-primary k-btn-md w-100">تغییر رمز</button>
        </form>
    </div>
</div>