@model GymClub.Application.Auth.Commands.ForgotPassword.ForgotPasswordCommand
@{
    ViewData["Title"] = "فراموشی رمز";
}

<div class="k-auth-wrapper">
    <div class="k-auth-card">
        <div class="k-label mb-2">بازیابی</div>
        <h2>فراموشی رمز عبور</h2>
        <p class="k-subtitle">شماره موبایل خود را وارد کنید تا کد بازیابی ارسال شود.</p>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="k-alert"></div>

            <div class="mb-6">
                <label asp-for="PhoneNumber" class="k-form-label">شماره موبایل</label>
                <input asp-for="PhoneNumber" class="k-input" dir="ltr" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <button type="submit" class="k-btn k-btn-primary k-btn-md w-100">ارسال کد بازیابی</button>

            <div class="mt-6 text-center text-[13px] text-midgray">
                <a asp-action="Login" class="k-link">بازگشت به ورود</a>
            </div>
        </form>
    </div>
</div>