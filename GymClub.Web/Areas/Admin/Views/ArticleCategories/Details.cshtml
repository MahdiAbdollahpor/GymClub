@model GymClub.Application.ArticleCategories.Queries.GetArticleCategoryDetails.ArticleCategoryDetailsDto
@using GymClub.Domain.Enums
@{
    ViewData["Title"] = "جزئیات دسته‌بندی مقالات";
}

<div class="mb-4 flex items-center justify-between flex-wrap gap-2">
    <div>
        <div class="k-label mb-1">جزئیات دسته مقالات</div>
        <h2 class="text-[20px] font-bold">@Model.Title</h2>
    </div>
    <div class="flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="k-btn k-btn-primary k-btn-md">ویرایش</a>
        <a asp-action="Index" class="k-btn k-btn-ghost k-btn-md">بازگشت</a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="space-y-4">
        <div class="k-card">
            <h4 class="k-label mb-3">اطلاعات دسته</h4>
            <table class="w-full text-[14px]">
                <tr class="border-b border-bordergray">
                    <td class="py-2 text-midgray w-[40%]">دسته والد</td>
                    <td class="py-2 font-medium">@(Model.ParentTitle ?? "—")</td>
                </tr>
                <tr class="border-b border-bordergray">
                    <td class="py-2 text-midgray">ترتیب</td>
                    <td class="py-2 font-mono">@Model.SortOrder</td>
                </tr>
                <tr class="border-b border-bordergray">
                    <td class="py-2 text-midgray">تعداد مقاله</td>
                    <td class="py-2 font-mono">@Model.Articles.Count</td>
                </tr>
                <tr>
                    <td class="py-2 text-midgray">تاریخ ایجاد</td>
                    <td class="py-2 font-mono text-[13px]">@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                </tr>
            </table>
        </div>
    </div>

    <div class="lg:col-span-2">
        <div class="k-card">
            <div class="flex items-center justify-between mb-3">
                <h4 class="k-label">مقالات این دسته (@Model.Articles.Count)</h4>
                <a asp-controller="Articles" asp-action="Create"
                   class="k-btn k-btn-ghost k-btn-sm">+ مقاله جدید</a>
            </div>

            @if (!Model.Articles.Any())
            {
                <div class="text-center text-midgray py-8 text-[14px]">
                    هنوز مقاله‌ای به این دسته اضافه نشده است.
                </div>
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var a in Model.Articles)
                    {
                        <div class="flex items-center justify-between p-3 border border-bordergray rounded-lg hover:border-primary transition-colors">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-lightgray rounded overflow-hidden flex-shrink-0">
                                    @if (!string.IsNullOrEmpty(a.CoverImageUrl))
                                    {
                                        <img src="@a.CoverImageUrl" class="w-full h-full object-cover" />
                                    }
                                </div>
                                <div>
                                    <div class="font-medium text-[14px]">@a.Title</div>
                                    <div class="text-[12px] text-midgray flex items-center gap-2">
                                        <span class="k-chip k-chip-crimson" style="font-size:10px">
                                            @(a.Type == ArticleType.Training ? "تمرین" : a.Type == ArticleType.Nutrition ? "تغذیه" : "باشگاه")
                                        </span>
                                        @if (a.PublishedAt.HasValue)
                                        {
                                            <span>@a.PublishedAt.Value.ToString("yyyy/MM/dd")</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                @if (a.PublishedAt.HasValue)
                                {
                                    <span class="k-chip k-chip-success">منتشر</span>
                                }
                                else
                                {

                                    <span class="k-chip k-chip-neutral">پیش‌نویس</span>
                                }
                                <a asp-controller="Articles" asp-action="Details" asp-route-id="@a.Id"
                                   class="k-btn k-btn-ghost k-btn-sm">مشاهده</a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>