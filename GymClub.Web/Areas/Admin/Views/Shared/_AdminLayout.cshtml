@using Microsoft.AspNetCore.Identity
@using GymClub.Domain.Entities
@inject UserManager<User> UserManager
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — پنل مدیریت</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: { preflight: false },
            theme: { extend: {
                colors: { primary:'#CC0000','primary-dark':'#990000',pure:'#0A0A0A',rich:'#1A1A1A',offblack:'#2D2D2D',warm:'#F9F9F9',lightgray:'#F0F0F0',midgray:'#8C8C8C',darkgray:'#4D4D4D',bordergray:'#E0E0E0' },
                fontFamily: { sans: ['Vazirmatn','Plus Jakarta Sans','sans-serif'], display: ['Vazirmatn','Syne','sans-serif'], mono: ['JetBrains Mono','monospace'] }
            }}
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .admin-sidebar {
            background: #0A0A0A;
            width: 260px;
        }

            .admin-sidebar a {
                color: #8C8C8C;
                padding: 12px 20px;
                display: block;
                font-size: 14px;
                text-decoration: none;
                border-right: 3px solid transparent;
            }

                .admin-sidebar a:hover {
                    color: #fff;
                    background: #1A1A1A;
                }

                .admin-sidebar a.active {
                    color: #fff;
                    border-right-color: #CC0000;
                    background: #1A1A1A;
                }

            .admin-sidebar .sidebar-section {
                padding: 20px 20px 8px;
                font-size: 11px;
                color: #4D4D4D;
                text-transform: uppercase;
                letter-spacing: .8px;
                font-weight: 600;
            }

        /* Mobile drawer */
        #adminSidebar {
            transform: translateX(100%);
            transition: transform .2s ease;
        }

            #adminSidebar.open {
                transform: translateX(0);
            }
        @@media (min-width: 768px) {
            #adminSidebar {
                transform: translateX(0);
                position: static !important;
            }

            #adminOverlay {
                display: none !important;
            }
        }
    </style>
</head>
<body class="bg-warm font-sans text-pure">

    <div class="flex min-h-screen">

        <!-- Overlay (mobile) -->
        <div id="adminOverlay"
             class="fixed inset-0 bg-black/50 z-30 hidden md:hidden"
             onclick="closeSidebar()"></div>

        <!-- Sidebar -->
        <aside id="adminSidebar"
               class="admin-sidebar fixed md:static top-0 right-0 h-screen z-40 flex-shrink-0 overflow-y-auto">
            <div class="p-5 border-b border-offblack flex items-center justify-between">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="flex items-center gap-2">
                    <span class="w-8 h-8 bg-primary flex items-center justify-center">
                        <span class="text-white font-mono font-bold">G</span>
                    </span>
                    <div>
                        <div class="text-white font-bold">GymClub</div>
                        <div class="text-midgray text-[11px]">پنل مدیریت</div>
                    </div>
                </a>
                <button onclick="closeSidebar()" class="md:hidden text-midgray hover:text-white p-1">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <nav class="py-4">
                <div class="sidebar-section">محتوا</div>
                <a asp-area="Admin" asp-controller="Articles" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Articles" ? "active" : "")">
                    📄 مقالات
                </a>
                <a asp-area="Admin" asp-controller="ArticleCategories" asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "ArticleCategories" ? "active" : "")">
                    🗂 دسته مقالات
                </a>

                <div class="sidebar-section">فروشگاه</div>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index">🧾 سفارشات</a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index">📦 محصولات</a>
                <a asp-area="Admin" asp-controller="ProductCategories" asp-action="Index">🗂 دسته محصولات</a>

                <div class="sidebar-section">برنامه ورزشی</div>
                <a asp-area="Admin" asp-controller="Questionnaires" asp-action="Index">📝 پرسشنامه‌ها</a>
                <a asp-area="Admin" asp-controller="WorkoutRequests" asp-action="Index">🏋️ درخواست‌های برنامه</a>

                <div class="sidebar-section">سایر</div>
                <a asp-area="" asp-controller="Home" asp-action="Index">🏠 مشاهده سایت</a>
            </nav>
        </aside>

        <!-- Main -->
        <div class="flex-1 min-w-0">
            <header class="bg-white border-b border-bordergray h-14 flex items-center px-4 md:px-6 justify-between sticky top-0 z-20">
                <div class="flex items-center gap-3">
                    <button onclick="openSidebar()" class="md:hidden p-1 text-darkgray hover:text-primary">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                    <h1 class="text-[16px] font-semibold">@ViewData["Title"]</h1>
                </div>
                <div class="flex items-center gap-3">
                    <span class="hidden sm:inline text-[13px] text-midgray font-mono" dir="ltr">@UserManager.GetUserName(User)</span>
                    <form method="post" asp-area="" asp-controller="Auth" asp-action="Logout">
                        <button class="k-btn k-btn-ghost k-btn-sm">خروج</button>
                    </form>
                </div>
            </header>

            <div class="p-4 md:p-6">
                @if (TempData["Success"] != null)
                {
                    <div class="k-alert k-alert-success mb-4">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="k-alert mb-4">@TempData["Error"]</div>
                }
                @RenderBody()
            </div>
        </div>
    </div>

    <script>
        function openSidebar() {
            document.getElementById('adminSidebar').classList.add('open');
            document.getElementById('adminOverlay').classList.remove('hidden');
        }
        function closeSidebar() {
            document.getElementById('adminSidebar').classList.remove('open');
            document.getElementById('adminOverlay').classList.add('hidden');
        }
    </script>

    <partial name="_ConfirmModal" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>