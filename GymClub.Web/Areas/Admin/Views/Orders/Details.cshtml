@model GymClub.Application.Orders.Queries.GetOrderDetails.OrderDetailsDto
@using GymClub.Domain.Enums
@{
    ViewData["Title"] = "جزئیات سفارش";
    string StatusLabel(OrderStatus s) => s switch
    {
        OrderStatus.PendingPayment => "منتظر پرداخت",
        OrderStatus.Paid => "پرداخت‌شده",
        OrderStatus.Confirmed => "تأیید شده",
        OrderStatus.Shipped => "ارسال شده",
        OrderStatus.Cancelled => "لغو شده",
        _ => "—"
    };
}

<div class="mb-4 flex items-center justify-between flex-wrap gap-2">
    <div>
        <div class="k-label mb-1">سفارش</div>
        <h2 class="text-[20px] font-bold font-mono">@Model.OrderNumber</h2>
    </div>
    <a asp-action="Index" class="k-btn k-btn-ghost k-btn-md">بازگشت</a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-4">
        <div class="k-card">
            <h3 class="text-[16px] font-semibold mb-3">آیتم‌ها</h3>
            @foreach (var i in Model.Items)
            {
                <div class="flex items-center gap-3 py-3 border-b border-bordergray last:border-0">
                    <div class="w-14 h-14 bg-lightgray rounded overflow-hidden flex-shrink-0">
                        @if (!string.IsNullOrEmpty(i.ProductImageUrl))
                        {
                            <img src="@i.ProductImageUrl" class="w-full h-full object-cover" />
                        }
                    </div>
                    <div class="flex-1">
                        <div class="font-medium text-[14px]">@i.ProductName</div>
                        <div class="text-[12px] text-midgray font-mono mt-1">@i.Quantity × @i.UnitPrice.ToString("N0")</div>
                    </div>
                    <div class="text-left font-mono text-[14px]">@i.LineTotal.ToString("N0")</div>
                </div>
            }
        </div>

        <div class="k-card">
            <h3 class="text-[16px] font-semibold mb-3">آدرس تحویل</h3>
            <div class="text-[14px] space-y-1">
                <div><span class="text-midgray">گیرنده:</span> @Model.ReceiverName</div>
                <div><span class="text-midgray">تلفن:</span> <span dir="ltr" class="font-mono">@Model.ReceiverPhone</span></div>
                <div><span class="text-midgray">آدرس:</span> @Model.Province، @Model.City، @Model.FullAddress</div>
            </div>
        </div>
    </div>

    <div class="space-y-4">
        <div class="k-card">
            <h3 class="text-[16px] font-semibold mb-3">وضعیت: @StatusLabel(Model.Status)</h3>

            @if (Model.Status == OrderStatus.Paid)
            {
                <form asp-action="Confirm" asp-route-id="@Model.Id" method="post" class="mb-2"
                      data-confirm-delete data-confirm-title="تأیید سفارش"
                      data-confirm-message="آیا این سفارش تأیید شود؟" data-confirm-ok="تأیید">
                    <button type="submit" class="k-btn k-btn-primary k-btn-md w-100">تأیید سفارش</button>
                </form>
            }
            else if (Model.Status == OrderStatus.Confirmed)
            {
                <form asp-action="Ship" asp-route-id="@Model.Id" method="post" class="mb-2">
                    <label class="k-form-label">کد رهگیری پستی</label>
                    <input name="trackingCode" class="k-input mb-2" required dir="ltr" />
                    <button type="submit" class="k-btn k-btn-primary k-btn-md w-100">ثبت ارسال</button>
                </form>
            }

            @if (Model.Status != OrderStatus.Shipped && Model.Status != OrderStatus.Cancelled)
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                    <label class="k-form-label">دلیل لغو</label>
                    <textarea name="reason" class="k-textarea mb-2" rows="2" required></textarea>
                    <button type="submit" class="k-btn k-btn-ghost k-btn-md w-100"
                            style="color:#CC0000;border:1px solid #CC0000">
                        لغو سفارش
                    </button>
                </form>
            }

            @if (!string.IsNullOrEmpty(Model.TrackingCode))
            {
                <div class="mt-3 pt-3 border-t border-bordergray text-[13px]">
                    <span class="text-midgray">کد رهگیری:</span>
                    <span class="font-mono font-bold" dir="ltr">@Model.TrackingCode</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.CancelReason))
            {
                <div class="k-alert mt-3" style="font-size:13px">دلیل لغو: @Model.CancelReason</div>
            }
        </div>

        <div class="k-card">
            <h3 class="text-[16px] font-semibold mb-3">مالی</h3>
            <div class="space-y-2 text-[14px]">
                <div class="flex justify-between"><span class="text-midgray">جمع جزء</span><span class="font-mono">@Model.SubTotal.ToString("N0")</span></div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="flex justify-between"><span class="text-midgray">تخفیف</span><span class="font-mono text-primary">@Model.DiscountAmount.ToString("N0") -</span></div>
                }
                <div class="flex justify-between"><span class="text-midgray">ارسال</span><span class="font-mono">@(Model.ShippingCost > 0 ? Model.ShippingCost.ToString("N0") : "رایگان")</span></div>
                <div class="flex justify-between font-bold pt-2 border-t border-bordergray">
                    <span>نهایی</span><span class="text-primary font-mono">@Model.Total.ToString("N0") تومان</span>
                </div>
            </div>
        </div>
    </div>
</div>