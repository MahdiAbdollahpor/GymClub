@model GymClub.Web.Areas.Admin.Models.ArticleFormViewModel
@using GymClub.Domain.Enums
@{
    ViewData["Title"] = "ویرایش مقاله";
    var categories = ViewBag.CategoryOptions as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new();
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data"
      class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CurrentCoverImageUrl" />
    <input type="hidden" asp-for="CurrentVideoUrl" />
    <div asp-validation-summary="ModelOnly" class="k-alert lg:col-span-3"></div>

    <div class="lg:col-span-2 space-y-4">
        <div class="k-card">
            <div class="mb-4">
                <label asp-for="Title" class="k-form-label">عنوان</label>
                <input asp-for="Title" class="k-input" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Summary" class="k-form-label">خلاصه</label>
                <textarea asp-for="Summary" class="k-textarea" rows="3"></textarea>
                <span asp-validation-for="Summary" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="ContentHtml" class="k-form-label">محتوا (HTML)</label>
                <textarea asp-for="ContentHtml" class="k-textarea" rows="16" dir="ltr"></textarea>
                <span asp-validation-for="ContentHtml" class="text-danger"></span>
            </div>
        </div>

        <div class="k-card">
            <h4 class="k-label mb-3">رسانه</h4>

            <div class="mb-4">
                <label asp-for="CoverImageFile" class="k-form-label">عکس کاور</label>
                @if (!string.IsNullOrEmpty(Model.CurrentCoverImageUrl))
                {
                    <div class="mb-2 flex items-center gap-3">
                        <img src="@Model.CurrentCoverImageUrl" alt="cover"
                             style="max-height:80px;border:1px solid #E0E0E0;border-radius:6px" />
                        <label class="k-check-label text-[13px]">
                            <input asp-for="RemoveCoverImage" class="k-checkbox" />
                            <span>حذف عکس فعلی</span>
                        </label>
                    </div>
                }
                <input asp-for="CoverImageFile" type="file" accept="image/*"
                       class="k-input" style="padding:8px" />
                <div class="k-helper">حداکثر ۵ مگابایت</div>
                <span asp-validation-for="CoverImageFile" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="VideoFile" class="k-form-label">ویدیو</label>
                @if (!string.IsNullOrEmpty(Model.CurrentVideoUrl))
                {
                    <div class="mb-2 flex items-center gap-3">
                        <video src="@Model.CurrentVideoUrl" controls
                               style="max-height:80px;border:1px solid #E0E0E0;border-radius:6px"></video>
                        <label class="k-check-label text-[13px]">
                            <input asp-for="RemoveVideo" class="k-checkbox" />
                            <span>حذف ویدیو فعلی</span>
                        </label>
                    </div>
                }
                <input asp-for="VideoFile" type="file" accept="video/*"
                       class="k-input" style="padding:8px" />
                <div class="k-helper">حداکثر ۵۰۰ مگابایت</div>
                <span asp-validation-for="VideoFile" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="space-y-4">
        <div class="k-card">
            <h4 class="k-label mb-3">تنظیمات انتشار</h4>
            <div class="space-y-3">
                <div>
                    <label asp-for="Type" class="k-form-label">نوع</label>
                    <select asp-for="Type" class="k-select">
                        <option value="@ArticleType.Training">تمرین</option>
                        <option value="@ArticleType.Nutrition">تغذیه</option>
                        <option value="@ArticleType.ClubIntro">معرفی باشگاه</option>
                    </select>
                </div>
                <div>
                    <label asp-for="CategoryId" class="k-form-label">دسته</label>
                    <select asp-for="CategoryId" asp-items="categories" class="k-select">
                        <option value="">— بدون دسته —</option>
                    </select>
                </div>
                <label class="k-check-label">
                    <input asp-for="Publish" class="k-checkbox" />
                    <span>منتشر شده</span>
                </label>
            </div>
        </div>

        <div class="flex gap-2">
            <button type="submit" class="k-btn k-btn-primary k-btn-md flex-1">ذخیره تغییرات</button>
            <a asp-action="Index" class="k-btn k-btn-ghost k-btn-md">انصراف</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}